# ============================================================
# Smart MES Platform - Central Configuration Template
# ============================================================
# 使用方式：
#   1. 複製此檔為 .env（同目錄）
#   2. 修改對應的值
#   3. .env 已被 .gitignore 忽略，不會被 commit
# ============================================================

# --- 前後端 Ports ---
FRONTEND_PORT=5173
RAG_PORT=9766
RAG_HOST=0.0.0.0

# --- Backend API URLs ---
VITE_RAG_API_DEV=http://localhost:9766
VITE_RAG_API=https://smart-mes-rag.onrender.com

# --- Netlify ---
# Netlify 站台 URL（Google OAuth 也要同步加這個網址）
NETLIFY_URL=https://smart-mes-dPpONf.netlify.app
# Netlify Site ID（在 Netlify Dashboard > Site settings 可找到）
NETLIFY_SITE_ID=c1e329f2-e2d2-40e6-945c-18b82da721ee
# Netlify Personal Access Token（在 https://app.netlify.com/user/applications 產生）
NETLIFY_AUTH_TOKEN=nfp_your_token_here

# --- Render ---
RENDER_API_KEY=rnd_your_render_api_key
RENDER_SERVICE_ID=srv-your-render-service-id
RENDER_SERVICE_NAME=your-render-service-name

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
ALLOWED_EMAIL=your-email@gmail.com

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...
SUPABASE_DB_HOST=db.your-project.supabase.co
SUPABASE_DB_PASSWORD=your-db-password

# --- GitHub ---
GITHUB_REPO=smart-mes-platform
GITHUB_USER=your-github-username

# --- Session ---
SESSION_TIMEOUT=172800

# --- 測試目錄（僅 deploy 模式使用）---
TEST_DIR=E:\test_smart-mes-platform
